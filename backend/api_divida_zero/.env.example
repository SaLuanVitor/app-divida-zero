# =============================================================================
# App Dívida Zero — Backend (Rails 8.1) — Exemplo de variáveis de ambiente
# =============================================================================
# Uso:
#   - Via docker-compose (recomendado p/ dev): NÃO precisa deste arquivo — o
#     docker-compose.yml já injeta POSTGRES_* e sobe o banco. Basta `docker compose up`.
#   - Rodando Rails NATIVO (fora do container): copie para `.env`
#       cp .env.example .env
#     e preencha. O gem `dotenv` carrega automaticamente em development/test.
#   - Produção (Railway): definir estas variáveis no painel do serviço, NÃO em arquivo.
#
# NUNCA commite o `.env` real (está no .gitignore). Este `.example` é seguro.
# Observação: o app usa `Rails.application.secret_key_base` (não credentials.yml.enc),
# então o `config/master.key` NÃO é necessário para rodar.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
RAILS_ENV=development

# --- Banco de dados (PostgreSQL) --------------------------------------------
# Para Rails nativo apontando ao Postgres do docker-compose, use host 127.0.0.1.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_divida_zero_development
POSTGRES_TEST_DB=app_divida_zero_test
RAILS_MAX_THREADS=5

# Em produção, prefira a URL única (Railway fornece):
# DATABASE_URL=postgres://user:pass@host:5432/app_divida_zero_production
# Opcionais (default = DATABASE_URL) — stack Solid:
# DATABASE_CACHE_URL=
# DATABASE_QUEUE_URL=
# DATABASE_CABLE_URL=

# --- Segredos / infra (produção) --------------------------------------------
# Gere com: bin/rails secret
# SECRET_KEY_BASE=
# SOLID_QUEUE_IN_PUMA=true
# WEB_CONCURRENCY=1

# --- Token do disparo da mensagem diária ------------------------------------
# Protege POST /api/v1/daily_message/dispatch (job GenerateDailyAiMessageJob).
DAILY_MESSAGE_DISPATCH_TOKEN=troque-por-um-token-secreto

# =============================================================================
# IA — Fase 1 (OpenRouter, free tier) — endpoint compatível com OpenAI
# =============================================================================
# O Ai::Client será parametrizado para ler AI_BASE_URL/AI_API_KEY/AI_MODEL.
# Sem AI_API_KEY, a IA cai no fallback canned (sem custo).
# Key grátis em: https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Legado (mantido p/ retrocompatibilidade enquanto Ai::Client não é migrado):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# =============================================================================
# Email — Fase 1 (Resend, SMTP) — conserta o reset de senha e envia boas-vindas
# =============================================================================
# Credenciais SMTP em: https://resend.com (API Keys). Porta 587 (STARTTLS).
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USER_NAME=resend
SMTP_PASSWORD=
# Remetente verificado (domínio próprio) ou onboarding@resend.dev p/ testes:
MAILER_FROM=nao-responder@seu-dominio.com
# Host usado nos links dos emails (ex.: reset de senha):
MAILER_DEFAULT_HOST=app-divida-zero-production-5333.up.railway.app

# =============================================================================
# WhatsApp — Fase 3 (Meta Cloud API via BSP)
# =============================================================================
# Deixe WHATSAPP_PROVIDER vazio para desligar o WhatsApp.
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
# Limite diário global de mensagens WhatsApp (default: 500):
WHATSAPP_DAILY_CAP=500
# Webhook secret para validação de callbacks do provider:
WHATSAPP_WEBHOOK_SECRET=
# Limites do rate limiter (token bucket):
WHATSAPP_BURST_SIZE=10
WHATSAPP_REFILL_RATE=1
