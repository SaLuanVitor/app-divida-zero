<div class="admin-page">
  <div class="page-header">
    <h1>Conexões Bancárias</h1>
    <div class="filters">
      <%= form_tag admin_financial_connections_path, method: :get, class: 'filter-form' do %>
        <div class="filter-group">
          <label>Status</label>
          <%= select_tag :status, options_for_select([['Todos', '']] + FinancialConnection.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), include_blank: false, class: 'form-select' %>
        </div>
        <div class="filter-group">
          <label>Provider</label>
          <%= select_tag :provider, options_for_select([['Todos', '']] + FinancialConnection.providers.keys.map { |p| [p.humanize, p] }, params[:provider]), include_blank: false, class: 'form-select' %>
        </div>
        <div class="filter-group">
          <label>Instituição</label>
          <%= text_field_tag :institution_id, params[:institution_id], placeholder: 'Buscar instituição...', class: 'form-input' %>
        </div>
        <div class="filter-group">
          <label>Usuário</label>
          <%= text_field_tag :user_id, params[:user_id], placeholder: 'ID do usuário', class: 'form-input' %>
        </div>
        <div class="filter-group">
          <%= submit_tag 'Filtrar', class: 'btn btn-primary' %>
          <%= link_to 'Limpar', admin_financial_connections_path, class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Usuário</th>
        <th>Instituição</th>
        <th>Provider</th>
        <th>Status</th>
        <th>Contas</th>
        <th>Último Sync</th>
        <th>Criado em</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @connections.each do |connection| %>
        <tr>
          <td><%= connection.id %></td>
          <td>
            <%= connection.user.name %><br>
            <small><%= connection.user.email %></small>
          </td>
          <td><%= connection.provider_institution_id.humanize %></td>
          <td><%= connection.provider.humanize %></td>
          <td><span class="status-badge status-<%= connection.status %>"><%= connection.status.humanize %></span></td>
          <td><%= connection.financial_accounts.count %></td>
          <td><%= connection.last_synced_at&.strftime('%d/%m %H:%M') || 'Nunca' %></td>
          <td><%= connection.created_at.strftime('%d/%m/%Y') %></td>
          <td>
            <%= link_to 'Ver', admin_financial_connection_path(connection), class: 'btn btn-sm btn-secondary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @connections %>

  <% if @connections.empty? %>
    <p style="text-align: center; color: #64748b; padding: 40px;">Nenhuma conexão encontrada</p>
  <% end %>
</div>

<style>
.admin-page {
  padding: 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24px;
  flex-wrap: wrap;
  gap: 16px;
}

.page-header h1 {
  font-size: 24px;
  font-weight: 600;
  color: #1e293b;
}

.filters {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 20px;
}

.filter-form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  align-items: end;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.filter-group label {
  font-size: 12px;
  font-weight: 500;
  color: #475569;
}

.form-select, .form-input {
  padding: 8px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  font-size: 14px;
  background: #fff;
}

.form-select:focus, .form-input:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow: hidden;
}

.admin-table th,
.admin-table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #e2e8f0;
}

.admin-table th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
  font-size: 12px;
  text-transform: uppercase;
  white-space: nowrap;
}

.admin-table tr:hover {
  background: #f8fafc;
}

.status-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
}

.status-active { background: #dcfce7; color: #166534; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-error { background: #fef2f2; color: #991b1b; }
.status-disconnected { background: #e2e8f0; color: #475569; }
.status-action_required { background: #fef3c7; color: #92400e; }

.btn {
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 500;
  font-size: 13px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: #3b82f6;
  color: #fff;
}

.btn-primary:hover {
  background: #2563eb;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #e2e8f0;
}

.btn-secondary:hover {
  background: #e2e8f0;
}

.btn-sm {
  padding: 4px 10px;
  font-size: 12px;
}

.pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 20px;
}

.pagination a, .pagination span {
  padding: 8px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  text-decoration: none;
  color: #475569;
}

.pagination .current {
  background: #3b82f6;
  color: #fff;
  border-color: #3b82f6;
}

.pagination .gap {
  color: #94a3b8;
}
</style>