<div class="metric-card">
  <h3>Provider Status</h3>
  <div class="metric-value">
    <div class="provider-status">
      <span class="provider-dot <%= provider_status[:online] ? 'online' : 'offline' %>"></span>
      <span><%= provider_status[:online] ? 'Online' : 'Offline' %></span>
    </div>
  </div>
  <div class="metric-detail">
    Provider: <%= provider_status[:name] %><br>
    Última verificação: <%= provider_status[:last_check].strftime('%H:%M:%S') %>
  </div>
</div>